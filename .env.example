DISCORD_TOKEN=
# Enable Message Content Intent in Developer Portal for !setup.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
# Optional: sync slash commands instantly to a test server.
TEST_GUILD_ID=

# manual: staff verifies money; payos: QR + verified webhook and reconciliation.
PAYMENT_PROVIDER=manual
# Manual QR: fill these 3 values; no payment API key or webhook needed.
BANK_BIN=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
STORE_BACKEND=postgres
# Supabase Connect > Session pooler URI (URL-encode password), keep credentials on host only.
DATABASE_URL=
STORE_DB_PATH=data/store.sqlite3
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Public HTTPS origin proxied to PAYMENT_HOST:PAYMENT_PORT (payos mode only).
PAYMENT_PUBLIC_URL=
PAYMENT_HOST=127.0.0.1
PAYMENT_PORT=8080
# INFO for normal operation; DEBUG adds database reads and notification details.
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
